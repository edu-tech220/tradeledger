@page
@model TradeLedger.Web.Pages.DashboardModel
@{
    ViewData["Title"] = "Dashboard";
}

<h1>Dashboard</h1>

<div class="row mb-4">
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h6 class="card-subtitle mb-2 text-muted">Cash balance</h6>
                <p class="card-text fs-4">@Model.Account.CashBalance.ToString("C")</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h6 class="card-subtitle mb-2 text-muted">Available cash</h6>
                <p class="card-text fs-4">@Model.Account.AvailableCash.ToString("C")</p>
                <p class="text-muted small">Cash minus funds reserved by pending limit buy orders.</p>
            </div>
        </div>
    </div>
</div>

<h2>Open positions</h2>
@if (Model.Positions.Count == 0)
{
    <p class="text-muted">No open positions yet. <a asp-page="/Orders/Place">Place an order</a> to get started.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Symbol</th>
                <th>Name</th>
                <th class="text-end">Quantity</th>
                <th class="text-end">Avg. cost</th>
                <th class="text-end">Current price</th>
                <th class="text-end">Market value</th>
                <th class="text-end">Unrealized P&amp;L</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var position in Model.Positions)
            {
                <tr>
                    <td>@position.Symbol</td>
                    <td>@position.Name</td>
                    <td class="text-end">@position.Quantity</td>
                    <td class="text-end">@position.AverageCost.ToString("C")</td>
                    <td class="text-end">@position.CurrentPrice.ToString("C")</td>
                    <td class="text-end">@position.MarketValue.ToString("C")</td>
                    <td class="text-end @(position.UnrealizedPnL >= 0 ? "text-success" : "text-danger")">@position.UnrealizedPnL.ToString("C")</td>
                </tr>
            }
        </tbody>
    </table>
}
