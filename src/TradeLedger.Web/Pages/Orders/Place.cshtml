@page
@model TradeLedger.Web.Pages.Orders.PlaceModel
@{
    ViewData["Title"] = "Place order";
}

<h1>Place order</h1>

<div class="row">
    <div class="col-md-6">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Symbol" class="form-label"></label>
                <select asp-for="Symbol" class="form-select" asp-items="Model.SymbolOptions"></select>
            </div>

            <div class="mb-3">
                <label asp-for="Side" class="form-label"></label>
                <select asp-for="Side" class="form-select">
                    <option value="Buy">Buy</option>
                    <option value="Sell">Sell</option>
                </select>
            </div>

            <div class="mb-3">
                <label asp-for="Type" class="form-label"></label>
                <select asp-for="Type" class="form-select" id="orderType">
                    <option value="Market">Market</option>
                    <option value="Limit">Limit</option>
                </select>
            </div>

            <div class="mb-3">
                <label asp-for="Quantity" class="form-label"></label>
                <input asp-for="Quantity" type="number" min="1" class="form-control" />
                <span asp-validation-for="Quantity" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="LimitPrice" class="form-label"></label>
                <input asp-for="LimitPrice" type="number" step="0.01" min="0.01" class="form-control" />
                <div class="form-text">Only used for Limit orders.</div>
            </div>

            <button type="submit" class="btn btn-primary">Submit order</button>
        </form>
    </div>
</div>
