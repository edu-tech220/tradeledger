@page
@model TradeLedger.Web.Pages.Trades.IndexModel
@{
    ViewData["Title"] = "Trade history";
}

<h1>Trade history</h1>

@if (Model.Trades.Items.Count == 0)
{
    <p class="text-muted">No executed trades yet.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Symbol</th>
                <th>Side</th>
                <th class="text-end">Quantity</th>
                <th class="text-end">Price</th>
                <th class="text-end">Realized P&amp;L</th>
                <th>Executed</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var trade in Model.Trades.Items)
            {
                <tr>
                    <td>@trade.Symbol</td>
                    <td>@trade.Side</td>
                    <td class="text-end">@trade.Quantity</td>
                    <td class="text-end">@trade.Price.ToString("C")</td>
                    <td class="text-end @(trade.RealizedPnL is >= 0 ? "text-success" : trade.RealizedPnL is < 0 ? "text-danger" : "")">
                        @(trade.RealizedPnL?.ToString("C") ?? "-")
                    </td>
                    <td>@trade.ExecutedAt.ToLocalTime().ToString("g")</td>
                </tr>
            }
        </tbody>
    </table>

    <nav>
        <ul class="pagination">
            @for (var p = 1; p <= Model.Trades.TotalPages; p++)
            {
                <li class="page-item @(p == Model.Trades.Page ? "active" : "")">
                    <a class="page-link" asp-page="/Trades/Index" asp-route-page="@p">@p</a>
                </li>
            }
        </ul>
    </nav>
}
